@startuml
title <size:24>Deployment View: Software System - One</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Deployment>

Deployment_Node(One.DevelopersComputer, "Developer's Computer", $type="", $descr="", $tags="", $link="") {
  Deployment_Node(One.DevelopersComputer.WebBrowser, "Web Browser", $type="", $descr="", $tags="", $link="") {
    Container(One.DevelopersComputer.WebBrowser.UI_1, "UI", $techn="JavaScript and React", $descr="Description", $tags="", $link="")
  }

  Container(One.DevelopersComputer.Backend_1, "Backend", $techn="Spring Boot", $descr="Description", $tags="", $link="")
}

Rel(One.DevelopersComputer.WebBrowser.UI_1, One.DevelopersComputer.Backend_1, "Makes API requests to", $techn="JSON/HTTPS", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml