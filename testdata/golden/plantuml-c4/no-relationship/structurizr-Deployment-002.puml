@startuml
title <size:24>Deployment View: Software System - Two</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Deployment>

Deployment_Node(Two.UsersComputer, "User's Computer", $type="", $descr="", $tags="", $link="") {
  Deployment_Node(Two.UsersComputer.WebBrowser, "Web Browser", $type="", $descr="", $tags="", $link="") {
    Container(Two.UsersComputer.WebBrowser.UI_1, "UI", $techn="JavaScript and React", $descr="Description", $tags="", $link="")
  }

}

Deployment_Node(Two.DataCenter, "Data Center", $type="", $descr="", $tags="", $link="") {
  Deployment_Node(Two.DataCenter.LoadBalancer, "Load Balancer", $type="", $descr="", $tags="", $link="")
  Deployment_Node(Two.DataCenter.Server, "Server", $type="", $descr="", $tags="", $link="") {
    Container(Two.DataCenter.Server.Backend_1, "Backend", $techn="Spring Boot", $descr="Description", $tags="", $link="")
  }

}

Rel(Two.UsersComputer.WebBrowser.UI_1, Two.DataCenter.LoadBalancer, "Makes API requests to", $techn="JSON/HTTPS", $tags="", $link="")
Rel(Two.DataCenter.LoadBalancer, Two.DataCenter.Server.Backend_1, "Forwards API requests to", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml