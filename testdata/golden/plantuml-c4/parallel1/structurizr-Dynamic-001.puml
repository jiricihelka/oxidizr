@startuml
title <size:24>Dynamic View: Software System</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

System_Boundary("SoftwareSystem_boundary", "Software System", $tags="") {
  Container(SoftwareSystem.WebApplication, "Web Application", $techn="", $descr="", $tags="", $link="")
  Container(SoftwareSystem.MessageBus, "Message Bus", $techn="", $descr="", $tags="", $link="")
  Container(SoftwareSystem.App1, "App 1", $techn="", $descr="", $tags="", $link="")
  Container(SoftwareSystem.App2, "App 2", $techn="", $descr="", $tags="", $link="")
}

Person(User, "User", $descr="", $tags="", $link="")

Rel(User, SoftwareSystem.WebApplication, "1: Updates details", $techn="", $tags="", $link="")
Rel(SoftwareSystem.WebApplication, SoftwareSystem.MessageBus, "2: Sends update event", $techn="", $tags="", $link="")
Rel(SoftwareSystem.MessageBus, SoftwareSystem.App1, "3: Broadcasts update event", $techn="", $tags="", $link="")
Rel(SoftwareSystem.MessageBus, SoftwareSystem.App2, "3: Broadcasts update event", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml