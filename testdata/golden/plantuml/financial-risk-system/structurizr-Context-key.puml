@startuml

set separator none
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Person
  .Element-RWxlbWVudCxQZXJzb24= {
    BackgroundColor: #d46a6a;
    LineColor: #944a4a;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,Software System
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0= {
    BackgroundColor: #801515;
    LineColor: #590e0e;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,Software System,Financial Risk System
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRmluYW5jaWFsIFJpc2sgU3lzdGVt {
    BackgroundColor: #550000;
    LineColor: #3b0000;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,Software System,Future State
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRnV0dXJlIFN0YXRl {
    BackgroundColor: #801515;
    LineColor: #590e0e;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Relationship,Asynchronous
  .Relationship-UmVsYXRpb25zaGlwLEFzeW5jaHJvbm91cw== {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Relationship,Asynchronous,Alert
  .Relationship-UmVsYXRpb25zaGlwLEFzeW5jaHJvbm91cyxBbGVydA== {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #ff0000;
    FontColor: #ff0000;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Relationship,Future State
  .Relationship-UmVsYXRpb25zaGlwLEZ1dHVyZSBTdGF0ZQ== {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // transparent element for relationships in legend
  .Element-Transparent {
    BackgroundColor: transparent;
    LineColor: transparent;
    FontColor: transparent;
  }
</style>

person "==Person" <<Element-RWxlbWVudCxQZXJzb24=>>

rectangle "==Software System" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>>

rectangle "==Software System, Financial Risk System" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRmluYW5jaWFsIFJpc2sgU3lzdGVt>>

rectangle "==Software System, Future State" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRnV0dXJlIFN0YXRl>>

rectangle "." <<.Element-Transparent>> as 1
1 --> 1 <<Relationship-UmVsYXRpb25zaGlw>> : "Relationship"

rectangle "." <<.Element-Transparent>> as 2
2 --> 2 <<Relationship-UmVsYXRpb25zaGlwLEFzeW5jaHJvbm91cw==>> : "Asynchronous"

rectangle "." <<.Element-Transparent>> as 3
3 --> 3 <<Relationship-UmVsYXRpb25zaGlwLEFzeW5jaHJvbm91cyxBbGVydA==>> : "Asynchronous, Alert"

rectangle "." <<.Element-Transparent>> as 4
4 --> 4 <<Relationship-UmVsYXRpb25zaGlwLEZ1dHVyZSBTdGF0ZQ==>> : "Future State"

@enduml