    FontSize: 24;
    MaximumWidth: 200;
  }
  // Relationship,Future State
  .Relationship-UmVsYXRpb25zaGlwLEZ1dHVyZSBTdGF0ZQ== {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
</style>

person "==Business User\n<size:16>[Person]</size>\n\nA regular business user." <<Element-RWxlbWVudCxQZXJzb24=>> as BusinessUser
person "==Configuration User\n<size:16>[Person]</size>\n\nA regular business user who can also configure the parameters used in the risk calculations." <<Element-RWxlbWVudCxQZXJzb24=>> as ConfigurationUser
rectangle "==Financial Risk System\n<size:16>[Software System]</size>\n\nCalculates the bank's exposure to risk for product X." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRmluYW5jaWFsIFJpc2sgU3lzdGVt>> as FinancialRiskSystem
rectangle "==Trade Data System\n<size:16>[Software System]</size>\n\nThe system of record for trades of type X." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as TradeDataSystem
rectangle "==Reference Data System\n<size:16>[Software System]</size>\n\nManages reference data for all counterparties the bank interacts with." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as ReferenceDataSystem
rectangle "==Reference Data System v2.0\n<size:16>[Software System]</size>\n\nManages reference data for all counterparties the bank interacts with." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRnV0dXJlIFN0YXRl>> as ReferenceDataSystemv20
rectangle "==E-mail system\n<size:16>[Software System]</size>\n\nThe bank's Microsoft Exchange system." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as Emailsystem
rectangle "==Central Monitoring Service\n<size:16>[Software System]</size>\n\nThe bank's central monitoring and alerting dashboard." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as CentralMonitoringService
rectangle "==Active Directory\n<size:16>[Software System]</size>\n\nThe bank's authentication and authorisation system." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as ActiveDirectory

BusinessUser --> FinancialRiskSystem <<Relationship-UmVsYXRpb25zaGlw>> : "Views reports using"
FinancialRiskSystem --> TradeDataSystem <<Relationship-UmVsYXRpb25zaGlw>> : "Gets trade data from"
FinancialRiskSystem --> ReferenceDataSystem <<Relationship-UmVsYXRpb25zaGlw>> : "Gets counterparty data from"
FinancialRiskSystem --> ReferenceDataSystemv20 <<Relationship-UmVsYXRpb25zaGlwLEZ1dHVyZSBTdGF0ZQ==>> : "Gets counterparty data from"
ConfigurationUser --> FinancialRiskSystem <<Relationship-UmVsYXRpb25zaGlw>> : "Configures parameters using"
FinancialRiskSystem --> Emailsystem <<Relationship-UmVsYXRpb25zaGlw>> : "Sends a notification that a report is ready to"
Emailsystem --> BusinessUser <<Relationship-UmVsYXRpb25zaGlwLEFzeW5jaHJvbm91cw==>> : "Sends a notification that a report is ready to\n<size:16>[E-mail message]</size>"
FinancialRiskSystem --> CentralMonitoringService <<Relationship-UmVsYXRpb25zaGlwLEFzeW5jaHJvbm91cyxBbGVydA==>> : "Sends critical failure alerts to\n<size:16>[SNMP]</size>"
FinancialRiskSystem --> ActiveDirectory <<Relationship-UmVsYXRpb25zaGlw>> : "Uses for user authentication and authorisation"

@enduml