@startuml
title <size:24>System Context View: Financial Risk System</size>\n<size:24>An example System Context diagram for the Financial Risk System architecture kata.</size>

set separator none
left to right direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Person
  .Element-RWxlbWVudCxQZXJzb24= {
    BackgroundColor: #d46a6a;
    LineColor: #944a4a;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0= {
    BackgroundColor: #801515;
    LineColor: #590e0e;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System,Financial Risk System
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRmluYW5jaWFsIFJpc2sgU3lzdGVt {
    BackgroundColor: #550000;
    LineColor: #3b0000;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System,Future State
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRnV0dXJlIFN0YXRl {
    BackgroundColor: #801515;
    LineColor: #590e0e;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Relationship,Asynchronous
  .Relationship-UmVsYXRpb25zaGlwLEFzeW5jaHJvbm91cw== {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Relationship,Asynchronous,Alert
  .Relationship-UmVsYXRpb25zaGlwLEFzeW5jaHJvbm91cyxBbGVydA== {
    LineThickness: 2;
    LineStyle: 10-10;
