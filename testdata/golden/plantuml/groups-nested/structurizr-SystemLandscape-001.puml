@startuml
title <size:24>System Landscape View</size>

set separator none
left to right direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element
  .Element-RWxlbWVudA== {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Organisation
  .Group-T3JnYW5pc2F0aW9u {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Organisation/Department A
  .Group-T3JnYW5pc2F0aW9uL0RlcGFydG1lbnQgQQ== {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Organisation/Department B
  .Group-T3JnYW5pc2F0aW9uL0RlcGFydG1lbnQgQg== {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

rectangle "Organisation" <<Group-T3JnYW5pc2F0aW9u>> as group1 {
  rectangle "==C\n<size:16>[Software System]</size>" <<Element-RWxlbWVudA==>> as C
    rectangle "Department A" <<Group-T3JnYW5pc2F0aW9uL0RlcGFydG1lbnQgQQ==>> as group2 {
      rectangle "==A\n<size:16>[Software System]</size>" <<Element-RWxlbWVudA==>> as A
    }

    rectangle "Department B" <<Group-T3JnYW5pc2F0aW9uL0RlcGFydG1lbnQgQg==>> as group3 {
      rectangle "==B\n<size:16>[Software System]</size>" <<Element-RWxlbWVudA==>> as B
    }

}


@enduml